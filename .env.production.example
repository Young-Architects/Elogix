# Production environment for a self-hosted (VPS) deploy.
#
# Copy to `.env.production` on the server and fill in the real values from
# Vercel -> Project -> Settings -> Environment Variables. Never commit the
# filled-in copy -- .gitignore covers `.env*`, and only THIS example file is
# excepted from that rule.
#
# ---------------------------------------------------------------------------
# BUILD TIME vs RUNTIME -- the thing that silently breaks migrations.
#
# Every NEXT_PUBLIC_* value is inlined into the client JS bundle during
# `next build`. It is NOT read when the server starts. If this file is
# incomplete at build time, those values are baked in as empty strings and the
# only symptom is that analytics quietly stops reporting -- the site looks
# fine. Fill this in BEFORE running `npm run build`, and rebuild (not just
# restart) after changing any NEXT_PUBLIC_* value.
#
# The unprefixed vars below are read at runtime, so a `pm2 reload` is enough
# for those.
# ---------------------------------------------------------------------------

# --- Runtime (a reload picks these up) ---

# Headless WordPress origin. next.config.ts derives the next/image allowlist
# from this hostname, so changing it to a host whose images you have not
# allowlisted will make blog featured images 400.
WORDPRESS_API_URL=https://lightseagreen-chough-517020.hostingersite.com

# Shared secret for POST /api/revalidate. Must match the value configured in
# the WordPress plugin (wordpress/blog-to-json-webhook.php) or published posts
# stop appearing on the site. If this is unset the route returns 500.
REVALIDATE_SECRET=

# n8n chat webhook behind /api/chat.
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_SECRET=

# --- Build time (a rebuild is required after any change) ---

NEXT_PUBLIC_SITE_URL=https://www.expendesk.com

# --- Optional. Both have working fallbacks in src/lib/site.ts, and NEITHER is
#     set on the current Vercel deployment. Leave them out unless you have a
#     reason, and the site behaves exactly as it does today.

# Unset -> falls back to the hardcoded production container 'GTM-5HQ9QMX7'.
# That is what the live site serves today. Set this ONLY to point a staging
# build at a different container, or to "" to disable GTM on staging.
# NEXT_PUBLIC_GTM_ID=

# Unset -> no google-site-verification meta tag is emitted, which is correct:
# the live site emits none either, so Search Console is verified by some other
# method. An EMPTY tag is worse than no tag, as it actively fails
# verification -- so do not set this to "".
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Deliberately NOT set: VERCEL_ENV.
# src/lib/site.ts falls back to NODE_ENV when it is absent, so a production
# build stays indexable. Setting it to anything other than "production" would
# apply a site-wide noindex.
